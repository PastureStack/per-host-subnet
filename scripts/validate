#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

expected_go_version="go1.26.6"
actual_go_version=$(go env GOVERSION)
if [ "$actual_go_version" != "$expected_go_version" ]; then
    printf 'Go toolchain mismatch: expected %s, got %s\n' "$expected_go_version" "$actual_go_version" >&2
    exit 1
fi
grep -Fxq 'toolchain go1.26.6' go.mod

unformatted=$(gofmt -l $(find . -path ./vendor -prune -o -name '*.go' -print))
if [ -n "$unformatted" ]; then
    printf 'Unformatted Go files:\n%s\n' "$unformatted" >&2
    exit 1
fi

go vet ./...
go mod verify

if [ -f .git ] && command -v wslpath >/dev/null 2>&1; then
    worktree_git_dir=$(sed -n 's/^gitdir: //p' .git)
    if [ -z "$worktree_git_dir" ]; then
        echo "The worktree .git file does not contain a gitdir pointer." >&2
        exit 1
    fi
    worktree_git_dir=$(wslpath -u "$worktree_git_dir")
    if [ ! -d "$worktree_git_dir" ]; then
        echo "The translated worktree gitdir does not exist: $worktree_git_dir" >&2
        exit 1
    fi
    git --git-dir="$worktree_git_dir" --work-tree="$PWD" diff --check
elif git rev-parse --git-dir >/dev/null 2>&1; then
    git diff --check
else
    echo "Unable to run the Git whitespace check in this worktree." >&2
    exit 1
fi
